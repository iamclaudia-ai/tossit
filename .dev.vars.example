# Copy to `.dev.vars` for local dev. In production these are set with `wrangler secret put`.
# See PLAN.md §9.

# 32+ random bytes, base64. Generate: openssl rand -base64 32
SESSION_SECRET=

# R2 — an API token scoped to the tossit-files bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tossit-files
R2_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Resend — used only for invite OTP emails.
RESEND_API_KEY=
OTP_FROM_EMAIL=auth@tossit.sh

OWNER_EMAIL=kiliman@gmail.com
