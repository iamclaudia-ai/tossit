{
	"extends": "./tsconfig.json",
	"include": [
		"vite.config.ts",
		"drizzle.config.ts",
		"scripts/**/*",
		// Scripts share the real presign helpers — no second implementation to drift.
		"app/lib/r2.ts"
	],
	"compilerOptions": {
		"composite": true,
		"strict": true,
		"types": ["node"],
		"lib": ["ES2022"],
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler"
	}
}
