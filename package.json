{
	"name": "tossit",
	"version": "0.1.0",
	"description": "Private file sharing for files too big to email.",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"cf-typegen": "wrangler types && react-router typegen",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply tossit --local",
		"db:migrate:remote": "wrangler d1 migrations apply tossit --remote",
		"deploy": "wrangler deploy",
		"dev": "react-router dev",
		"preview": "bun run build && vite preview",
		"typecheck": "bun run cf-typegen && tsc -b",
		"cli": "bun run cli/tossit.ts",
		"cli:build": "cd cli && bun run build"
	},
	"dependencies": {
		"@simplewebauthn/browser": "^14.0.0",
		"@simplewebauthn/server": "^14.1.0",
		"aws4fetch": "^1.0.20",
		"drizzle-orm": "^0.45.4",
		"isbot": "5.2.3",
		"nanoid": "^6.0.2",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-router": "8.5.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@cloudflare/vite-plugin": "1.69.1",
		"@react-router/dev": "8.5.2",
		"@tailwindcss/vite": "4.3.5",
		"@types/node": "^26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"drizzle-kit": "^0.31.11",
		"tailwindcss": "4.3.5",
		"typescript": "5.9.3",
		"vite": "^8.3.8",
		"vite-tsconfig-paths": "6.1.1",
		"wrangler": "^4.160.0"
	}
}
