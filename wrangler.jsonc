/**
 * tossit.sh — Worker configuration.
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Note: static assets are wired up automatically by @cloudflare/vite-plugin, so there is
 * deliberately no "assets" block here.
 */
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "tossit",
	"main": "./workers/app.ts",
	// Highest date the installed workerd supports. Bumping past it makes local dev silently
	// fall back, so dev and prod would run different semantics.
	"compatibility_date": "2025-11-25",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"upload_source_maps": true,

	/** D1 — all relational data (see PLAN.md §3). */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tossit",
			"database_id": "c4562c60-0716-48bb-b92a-d32f77c5b6f1",
			"migrations_dir": "drizzle/migrations"
		}
	],

	/**
	 * R2 — download path ONLY. Uploads never touch this binding; the whole multipart
	 * lifecycle goes over the S3 API via aws4fetch. See PLAN.md §6.
	 */
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "tossit-files",
			/**
			 * Reads the real bucket even in local dev. Uploads go browser → R2 directly via
			 * presigned URLs, so they always land in the real bucket; with the local simulation
			 * every download in dev would 404 on a file that plainly exists. D1 stays local, so
			 * dev metadata never touches production.
			 */
			"remote": true
		}
	],

	/**
	 * Custom domain. Creates and manages the DNS record for tossit.sh automatically.
	 *
	 * workers_dev is off on purpose: a second public origin would mean download links exist at
	 * two hostnames, and passkeys would break there anyway because the WebAuthn rpID must match
	 * the domain exactly.
	 */
	"workers_dev": false,
	"routes": [{ "pattern": "tossit.sh", "custom_domain": true }],

	/**
	 * TODO (Phase 7): re-enable the daily cleanup cron once there's a scheduled() handler to
	 * receive it — expired files, stale multipart uploads, dead invites/OTPs/challenges. A cron
	 * with no handler just errors on a schedule.
	 * "triggers": { "crons": ["17 4 * * *"] },
	 */

	"vars": {
		"APP_URL": "https://tossit.sh"
	}
}
